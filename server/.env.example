# 文衡演示站配置：复制为 server/.env 后修改
# 登录账号（提供给组委会的测试账号）
WENHENG_USER=demo
# 口令没有默认值（rick 2026-10-02）：首次使用请在这里设置；空口令无法登录
WENHENG_PASS=
# 会话签名密钥：上线前务必改成随机长串
WENHENG_SECRET=change-me-to-a-long-random-string
# 公网地址：写入二维码与说明书，例如 http://8.8.8.8:8080
WENHENG_PUBLIC_URL=
# 可选：第 4 期金样原件 docx 路径（配置后才显示“附加金样回测”选项）
WENHENG_REFERENCE_DOCX=
# 可选：流水线 Python（默认与 web 服务同一解释器）
WENHENG_PYTHON=
# 演示时在登录页显示账号提示（1=显示）
WENHENG_SHOW_HINT=0
# 只读游客账号（登录页「以游客身份浏览」入口用它；公网部署时与管理员口令一起改）
WENHENG_GUEST_USER=guest
WENHENG_GUEST_PASS=guest@2026
# 登录页是否显示游客入口（1=显示，默认显示；公网不想公开只读入口就设 0）
WENHENG_SHOW_GUEST=1

# ── AI 层云适配器（可选；不配 = 纯规则版，零外发）─────────────────────────
# 演示站/公网部署建议留空或显式设 WENHENG_AI_PROFILE=demo（永远规则版）。
# key 只放本机 .env，不得入库、不得进部署包。
WENHENG_AI_BACKEND=
WENHENG_AI_BASE_URL=
WENHENG_AI_MODEL=
WENHENG_AI_KEY=
# 单次调用秒数 / 输出预算 / 外发字符上限（超过即回落，不发包）
WENHENG_AI_TIMEOUT=30
WENHENG_AI_MAX_TOKENS=2048
WENHENG_AI_MAX_CHARS=6000
# 部署锁：=demo 时强制规则版（即使本机有 key 也不出网）
WENHENG_AI_PROFILE=
